<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SceneOrchestrator.UI\SceneOrchestrator.UI.csproj" />
  </ItemGroup>

  <Target Name="CopyAssimpNative" AfterTargets="Build">
    <ItemGroup>
      <_AssimpNative Include="$(NuGetPackageRoot)assimpnet/4.1.0/runtimes/linux-x64/native/libassimp.so"
                     Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
      <_AssimpNative Include="$(NuGetPackageRoot)assimpnet/4.1.0/runtimes/win-x64/native/assimp.dll"
                     Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    </ItemGroup>
    <Copy SourceFiles="@(_AssimpNative)" DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
